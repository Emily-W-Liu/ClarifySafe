{
  "openapi": "3.1.0",
  "info": {
    "title": "ClarifySafe Agent API",
    "version": "0.4.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/runs": {
      "post": {
        "summary": "Start",
        "operationId": "start_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{run_id}": {
      "get": {
        "summary": "Status",
        "operationId": "status_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{run_id}/responses": {
      "post": {
        "summary": "Respond",
        "operationId": "respond_runs__run_id__responses_post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserResponse"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{run_id}/events": {
      "get": {
        "summary": "Events",
        "operationId": "events_runs__run_id__events_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "After"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Action": {
        "properties": {
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "arguments": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object",
            "title": "Arguments"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tool",
          "arguments"
        ],
        "title": "Action"
      },
      "AgentEvent": {
        "properties": {
          "sequence": {
            "type": "integer",
            "title": "Sequence"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "event_type": {
            "type": "string",
            "title": "Event Type"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sequence",
          "run_id",
          "event_type",
          "payload"
        ],
        "title": "AgentEvent"
      },
      "AgentInput": {
        "properties": {
          "instruction": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Instruction"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "instruction"
        ],
        "title": "AgentInput"
      },
      "AgentResult": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "mode": {
            "type": "string",
            "enum": [
              "scripted_mock",
              "llm_mock",
              "llm_appworld"
            ],
            "title": "Mode",
            "default": "scripted_mock"
          },
          "pending": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pending"
          },
          "state": {
            "$ref": "#/components/schemas/TaskState"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "status",
          "state"
        ],
        "title": "AgentResult"
      },
      "Approval": {
        "properties": {
          "action_fingerprint": {
            "type": "string",
            "title": "Action Fingerprint"
          },
          "approved": {
            "type": "boolean",
            "title": "Approved"
          },
          "source": {
            "type": "string",
            "const": "user",
            "title": "Source",
            "default": "user"
          },
          "approval_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Id"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "operation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Operation Id"
          },
          "policy_digest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy Digest"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action_fingerprint",
          "approved"
        ],
        "title": "Approval"
      },
      "Candidate": {
        "properties": {
          "object_id": {
            "type": "string",
            "title": "Object Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "source": {
            "type": "string",
            "enum": [
              "user",
              "application",
              "model"
            ],
            "title": "Source"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "object_id",
          "label",
          "source"
        ],
        "title": "Candidate"
      },
      "EventPage": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/AgentEvent"
            },
            "type": "array",
            "title": "Events"
          },
          "next_after": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Next After"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "events",
          "next_after"
        ],
        "title": "EventPage"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JsonValue": {},
      "RiskAssessment": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "act",
              "ask",
              "confirm",
              "decline"
            ],
            "title": "Decision"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          },
          "risk": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ToolRisk"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "reasons"
        ],
        "title": "RiskAssessment"
      },
      "TaskState": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "instruction": {
            "type": "string",
            "title": "Instruction"
          },
          "mode": {
            "type": "string",
            "enum": [
              "scripted_mock",
              "llm_mock",
              "llm_appworld"
            ],
            "title": "Mode",
            "default": "scripted_mock"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "waiting_for_user",
              "declined",
              "stopped",
              "completed"
            ],
            "title": "Status",
            "default": "running"
          },
          "decision": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "act",
                  "ask",
                  "confirm",
                  "decline"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Decision"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "type": "array",
            "title": "Candidates"
          },
          "action": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Action"
              },
              {
                "type": "null"
              }
            ]
          },
          "approval": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Approval"
              },
              {
                "type": "null"
              }
            ]
          },
          "before": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Before"
          },
          "verification": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VerificationResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "user_answers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "User Answers"
          },
          "clarification_round": {
            "type": "integer",
            "title": "Clarification Round",
            "default": 0
          },
          "question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Question"
          },
          "minutes_content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Minutes Content"
          },
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer"
          },
          "model_metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Model Metadata"
          },
          "policy_digest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy Digest"
          },
          "risk_assessment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RiskAssessment"
              },
              {
                "type": "null"
              }
            ]
          },
          "step_index": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Step Index",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "instruction"
        ],
        "title": "TaskState"
      },
      "ToolRisk": {
        "properties": {
          "externally_visible": {
            "type": "boolean",
            "title": "Externally Visible"
          },
          "reversible": {
            "type": "boolean",
            "title": "Reversible"
          },
          "affected_objects": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Affected Objects"
          },
          "required_permissions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Required Permissions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "externally_visible",
          "reversible",
          "affected_objects",
          "required_permissions"
        ],
        "title": "ToolRisk",
        "description": "Trusted adapter metadata for a bounded tool, never supplied by the model."
      },
      "UserResponse": {
        "properties": {
          "intervention_id": {
            "type": "string",
            "title": "Intervention Id"
          },
          "choice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Choice"
          },
          "approved": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approved"
          },
          "text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "intervention_id"
        ],
        "title": "UserResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VerificationResult": {
        "properties": {
          "passed": {
            "type": "boolean",
            "title": "Passed"
          },
          "checks": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "passed",
          "checks"
        ],
        "title": "VerificationResult"
      }
    }
  }
}
