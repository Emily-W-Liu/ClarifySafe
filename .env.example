# Copy to .env and fill in your own credentials. Never commit the real key.
# Load explicitly with: uv run --env-file .env clarifysafe --mode llm start '...'
CLARIFYSAFE_MODEL=
CLARIFYSAFE_API_KEY=
CLARIFYSAFE_BASE_URL=https://api.moonshot.cn/v1
CLARIFYSAFE_RESPONSE_FORMAT=json_schema
CLARIFYSAFE_TOKEN_PARAMETER=max_tokens
CLARIFYSAFE_MAX_OUTPUT_TOKENS=4096
CLARIFYSAFE_TIMEOUT_SECONDS=120
CLARIFYSAFE_MAX_CALLS=8
